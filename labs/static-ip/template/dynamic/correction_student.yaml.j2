labs_path: ../create_lab.py
convergence_time: 5
default_image: kathara/base
structure: lab.conf

# Ce fichier est utilisé pour exécuter une série de tests sur le labo.
# Sur INGInious il y en plus de tests, je vous suggère d'enrichir ce fichier pour couvrir les cas classiques de connectivité et de routage.
# Voir ici pour plus d'infos : https://github.com/KatharaFramework/kathara-lab-checker
test:
  requiring_startup:
    - h1
    - h2
    - r1
    - r2

  ip_mapping:
    h1: { eth0: {{ expected.h1.interfaces.eth0.cidr }} }

  reachability:
    # Tests de connectivité de base (ping)
    h1:
      - {{ expected.h2.interfaces.eth0.cidr.split("/")[0] }}    # Ping de h1 vers h2


