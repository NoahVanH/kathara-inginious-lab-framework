labs_path: ../create_lab.py
convergence_time: 5
default_image: kathara/base
structure: lab.conf

test:
  requiring_startup:
    - h1
    - h2
    - r1
    - r2

  ip_mapping:
    h1: { eth0: {{ expected.h1.interfaces.eth0.cidr }} }
    r1: { eth0: {{ expected.r1.interfaces.eth0.cidr }}, eth1: {{ expected.r1.interfaces.eth1.cidr }} }
    r2: { eth0: {{ expected.r2.interfaces.eth0.cidr }}, eth1: {{ expected.r2.interfaces.eth1.cidr }} }
    h2: { eth0: {{ expected.h2.interfaces.eth0.cidr }} }

  reachability:
    h1:
      - {{ expected.h2.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.r1.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.r2.interfaces.eth0.cidr.split('/')[0] }}

    h2:
      - {{ expected.h1.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.r2.interfaces.eth1.cidr.split('/')[0] }}
      - {{ expected.r1.interfaces.eth1.cidr.split('/')[0] }}

    r1:
      - {{ expected.h1.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.r2.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.h2.interfaces.eth0.cidr.split('/')[0] }}

    r2:
      - {{ expected.r1.interfaces.eth1.cidr.split('/')[0] }}
      - {{ expected.h2.interfaces.eth0.cidr.split('/')[0] }}
      - {{ expected.h1.interfaces.eth0.cidr.split('/')[0] }}