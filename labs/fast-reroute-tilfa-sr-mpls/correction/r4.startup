#!/bin/bash




ip link set dev lo up

ip link set dev eth0 up
ip -6 addr add 3fff:a3:3d29::1/64 dev eth0
sysctl -w net.mpls.conf.eth0.input=1
sysctl -w net.mpls.platform_labels=100000
sysctl -w net.ipv6.conf.all.forwarding=1

ip link set dev eth1 up
ip -6 addr add 3fff:55:e189::1/64 dev eth1
sysctl -w net.mpls.conf.eth1.input=1
sysctl -w net.mpls.platform_labels=100000
sysctl -w net.ipv6.conf.all.forwarding=1

ip link set dev eth2 up
ip -6 addr add 3fff:d0:76ff::2/64 dev eth2
sysctl -w net.mpls.conf.eth2.input=1
sysctl -w net.mpls.platform_labels=100000
sysctl -w net.ipv6.conf.all.forwarding=1

ip link set dev eth3 up
ip -6 addr add 3fff:23:feac::1/64 dev eth3
sysctl -w net.mpls.conf.eth3.input=1
sysctl -w net.mpls.platform_labels=100000
sysctl -w net.ipv6.conf.all.forwarding=1






# with custom image
#sleep 5
#su -c "/usr/lib/frr/frrinit.sh start"

# with kathara image
systemctl start frr
