#!/bin/bash


ip link set dev lo up
ip -6 addr add 2001:db8:1::4/128 dev lo

ip link set dev eth0 up
ip -6 addr add 2001:db8:70f5::2/64 dev eth0

ip link set dev eth1 up
ip -6 addr add 2001:db8:65d7::2/64 dev eth1

ip link set dev eth2 up
ip -6 addr add 2001:db8:37fb::2/64 dev eth2

ip link set dev eth3 up
ip -6 addr add 2001:db8:650d::1/64 dev eth3








ip -6 route add 2001:db8:1::4/128 dev lo
systemctl start frr
